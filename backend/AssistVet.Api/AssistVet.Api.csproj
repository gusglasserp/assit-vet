<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1bf48e8a-84c4-44e3-9156-5a3450b340d1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Recursos\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- As páginas (pasta web/ na raiz do repositório) vão junto na publicação, como wwwroot.
       Cópia simples depois do publish: incluir como Content ativaria o pipeline de static web assets,
       que exige uma pasta wwwroot no projeto e quebra o dotnet run. -->
  <Target Name="CopiarPaginas" AfterTargets="Publish">
    <ItemGroup>
      <Paginas Include="..\..\web\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Paginas)" DestinationFiles="@(Paginas->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
